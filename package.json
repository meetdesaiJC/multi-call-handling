{
  "name": "jclite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "JustCall AI Agent Assist prototype.",
  "files": [
    "dist",
    "src/styles/globals.css"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./src/styles/globals.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --config prototype-justcall-ai/vite.config.ts",
    "proto:add-ons": "vite --config prototype-add-ons-flow/vite.config.ts",
    "proto:justcall-ai": "vite --config prototype-justcall-ai/vite.config.ts",
    "build": "vite build --config prototype-justcall-ai/vite.config.ts",
    "build:lib": "vite build --config vite.lib.config.ts",
    "build:watch": "vite build --config vite.lib.config.ts --watch",
    "preview": "vite preview --config prototype-justcall-ai/vite.config.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "tsc --noEmit -p tsconfig.all.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build:add-ons": "vite build --config prototype-add-ons-flow/vite.config.ts",
    "verify": "npm run lint && npm run typecheck && npm run build && npm run build:add-ons && npm run build-storybook",
    "icons:catalog": "node scripts/icons/catalog.mjs",
    "icons:pull": "node scripts/icons/pull.mjs",
    "icons:clean": "node scripts/icons/clean.mjs",
    "icons:generate": "node scripts/icons/generate.mjs",
    "icons:sync-used": "node scripts/icons/pull.mjs --used && node scripts/icons/clean.mjs && node scripts/icons/generate.mjs"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "^9.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "storybook": "^9.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.0.0",
    "vite-plugin-dts": "^4.5.4"
  }
}
